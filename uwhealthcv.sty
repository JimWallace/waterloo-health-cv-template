%% uwhealthcv.sty -- the University of Waterloo Faculty of Health CV format.
%%
%% The template half of this repository. A CV loads this one package and
%% supplies only its own content:
%%
%%   \input{uwhealthcv-pdfa}     % PDF/A-2b output (optional; see that file)
%%   \documentclass[11pt]{article}   % the Faculty's format is 11pt
%%   \usepackage{uwhealthcv}
%%   \addbibresource{mycv.bib}
%%   \setreviewperiod{2025}{2026}
%%   ... \DeclareBibliographyCategory / \addtocategory lists ...
%%   \begin{document} ... \end{document}
%%
%% For the APR version, a second file passes the "apr" option and inputs the
%% first (see ../apr.tex):
%%
%%   \PassOptionsToPackage{apr}{aprcv}
%%   \input{main}
%%
%% Files read here, in this order (the order matters):
%%   NSERC-formatting.tex     page, fonts, headers, tables
%%   biblatex (ACM style)     with biblatex-formatting.tex
%%   aprcv.sty                APR highlighting; reads the CV's own
%%                            apr-formatting.tex, if present
%%   cv-records.tex           grants, supervision, committees and other
%%                            records as biblatex entries
%%                            (data model: uwhealthcv.dbx)
%%   cv-layout.tex            page-break rules (\keepwithnext, \sectionbreak)
%%
%% The template directory must be on TeX's search path: latexmkrc in the CV's
%% directory adds it (Overleaf and CI read that file too).

\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{uwhealthcv}[2026/11/24 v0.11.0 Faculty of Health CV format]

% gaps: a review copy that marks missing data (see "missing data" below)
\newif\ifcvgaps
\DeclareOption{gaps}{\cvgapstrue}
\DeclareOption{apr}{\PassOptionsToPackage{apr}{aprcv}}
\DeclareOption{plain}{\PassOptionsToPackage{plain}{aprcv}}
\ProcessOptions\relax
% \def\cvshowgaps{} before \usepackage{uwhealthcv} does the same as the gaps
% option; a wrapper file (gaps.tex) can set it without an "unknown option"
% error on template versions that predate it
\ifdefined\cvshowgaps\cvgapstrue\fi

% The Faculty of Health's format is set in 11pt Times (NSERC-formatting.tex)
\ifnum0\@ptsize=1 \else
  \PackageWarningNoLine{uwhealthcv}{The Faculty of Health CV format is 11pt:\MessageBreak
    use \protect\documentclass[11pt]{article}}
\fi

\RequirePackage{enumitem}
\RequirePackage[table,xcdraw]{xcolor}
% the award badge (biblatex-formatting.tex); after xcolor, so xcolor gets its options
\RequirePackage{tikz}
\input{NSERC-formatting}

\ifdefined\directlua\else\RequirePackage[utf8]{inputenc}\fi% UTF-8 is native in LuaLaTeX
\RequirePackage[
    style=ACM-Reference-Format,
    backend=biber,
    sorting=ydnt,
    giveninits,
    maxcitenames=99,
    maxbibnames=99,
    defernumbers=true,
    locallabelwidth=true,
    datamodel=uwhealthcv,
]{biblatex}
\input{biblatex-formatting}

\RequirePackage{aprcv}
\input{cv-records}

% \setcvnumber{name}{value} and \cvnumber{name}: a count a script generates
% from the record (papers in the review period, how many a trainee led),
% defined in a file the CV inputs and printed in the CV's own sentences, so
% the sentence stays true as the record grows. An undefined name prints a
% bold ?? and warns, as an undefined \ref does.
\newcommand\setcvnumber[2]{\csgdef{cvnumber/#1}{#2}}
\newcommand\cvnumber[1]{%
  \ifcsdef{cvnumber/#1}
    {\csuse{cvnumber/#1}}
    {\textbf{??}\cv@gapbox{#1}\PackageWarning{uwhealthcv}{Number `#1' is not
      defined (no \string\setcvnumber{#1})}}}

%% ----------------------------------------------------------- missing data
% The gaps option (or \def\cvshowgaps{}) makes a review copy, for the owner
% only, that marks missing data in its own colour (CVgap, orange: none of the
% APR colours) so it can be filled in before a CV goes out. Without it,
% nothing below prints and the CV is unchanged.
%   \setentrygap{key}{text}  "Missing: text" under that entry (bibliography
%                            entries and every record type; a script usually
%                            writes these from the CV's own rules)
%   \cvgap{text}             a mark in running text, e.g. \cvgap{year}
% A grant's blank amount, tenure, agency, title or role is marked without
% being asked for, and so is an undefined \cvnumber. Change the colours
% with \definecolor{CVgap}{...} and \definecolor{CVgapText}{...}.
\definecolor{CVgap}{RGB}{255,140,0}
\definecolor{CVgapText}{RGB}{170,40,0}
\newcommand\setentrygap[2]{\csgdef{cv@gap@#1}{#2}}
\newcommand\cv@gapbox[1]{\ifcvgaps{\setlength\fboxsep{1pt}%
  \colorbox{CVgap}{\textcolor{black}{\sffamily\footnotesize\bfseries #1?}}}\fi}
\newcommand\cvgap[1]{\cv@gapbox{#1}}
\newcommand\cv@gapnote[1]{{\small{\setlength\fboxsep{1pt}%
  \colorbox{CVgap}{\textcolor{black}{\sffamily\bfseries Missing}}}\space
  \textcolor{CVgapText}{#1}}}
% \cv@entrygap: the gap text of the entry being printed (empty if none)
\newcommand\cv@entrygap{%
  \ifcvgaps\ifcsdef{cv@gap@\thefield{entrykey}}%
    {\letcs\cv@thisgap{cv@gap@\thefield{entrykey}}}{\let\cv@thisgap\@empty}%
  \else\let\cv@thisgap\@empty\fi}

%% ------------------------------------------------------- section markup
% The building blocks of the Faculty of Health layout, so a CV names its
% structure instead of repeating the list settings. Spacing between sections
% stays in the CV, with \sectionbreak and \keepwithnext (cv-layout.tex).
%
%   \cvsection{TITLE}           a section heading (bold)
%   \cvsubheading{Label:}       a label over a list, kept with the list
%   \begin{cvlist}[itemsep]     an unnumbered list of \cvitem in the
%                               content column (0.5in)
%     \cvitem text              (itemsep defaults to -5pt)
%   \end{cvlist}
%   \begin{cvbulletlist}[itemsep] the same, with a bullet hanging to the left
%     \cvitem text              of each item, for entries that run to two lines
%   \end{cvbulletlist}          (itemsep defaults to 0pt)
%   \begin{cvgroup}{PhD}        a label in the left column, with the list
%     \begin{cvbulletlist}...   starting on the line below it
%   \end{cvgroup}
%   \begin{cvparts}             lettered parts a), b), c) ... of a section
%     \cvpart{Title}            one part, with a bold title
%     \cvpart*{Title}           one part, with a plain title
%   \end{cvparts}
%
% The indents and blank lines follow the Faculty's format (see "The Faculty
% of Health grid and spacing" below): a CV needs no \\ or \vspace between
% a heading and its list, or between parts.
%   \printcategory[J]{journal}  print one bibliography category, numbered
%                               J1, J2, ... (no prefix: 1, 2, ...)
%
% Grants and supervision are biblatex records: see cv-records.tex.
\newcommand\cvsection[1]{\global\cv@afterlabelfalse\cv@heading{H1}{\textbf{#1}}}
\newcommand\cvsubheading[1]{%
  \cv@block\keepwithnext\cv@heading{H2}{#1}\global\cv@afterlabeltrue}
% Tagged PDF (uwhealthcv-pdfa.tex): \ifcv@tagged is true when the kernel tags
% the document. \cv@heading{H1}{text} tags its text as a heading. Headings
% here often share a paragraph with what follows ("NAME/DATE: Name", or a
% heading, \\ and text), so the heading becomes its own structure element and
% the rest of the paragraph a P after it. Nothing changes on the page.
% TikZ keys that work with or without tagging: [cv/decorative] makes a
% picture an artifact (skipped by screen readers), [cv/alt={text}] gives a
% figure its alternative text.
\newif\ifcv@tagged
\ifdefined\GetDocumentProperties
  \edef\cv@tmp{\GetDocumentProperties{document/tagging}}%
  \def\cv@tmpb{active}%
  \ifx\cv@tmp\cv@tmpb \cv@taggedtrue \fi
\fi
\ifcv@tagged
  \tagpdfsetup{
    table/header-rows=1,% every table's first row is its headings
    math/mathml/luamml/load=false}% maths (a few symbols) is tagged with its LaTeX source
  % in the tagging family, so tikzpicture reads them before it starts
  \tikzset{cv/decorative/.style={artifact}, cv/alt/.style={alt={#1}},
    cv/decorative/.belongs to family=/tikz/tagging-setup,
    cv/alt/.belongs to family=/tikz/tagging-setup}
\else
  \tikzset{cv/decorative/.style={}, cv/alt/.style={}}
\fi
\ExplSyntaxOn
\cs_new_protected:Npn \cv@heading #1#2
  {
    \legacy_if:nTF { cv@tagged }
      {
        \mode_if_vertical:TF
          { \group_begin: \tagpdfsetup { para/tag = #1 } \leavevmode \group_end: }
          { \tagmcend \tagstructend \tagstructbegin { tag = #1 } \tagmcbegin { } }
        #2
        \peek_meaning:NTF \c_space_token
          { \peek_remove_spaces:n { \peek_after:Nw \__cv_heading_after_space: } }
          { \peek_after:Nw \__cv_heading_after: }
      }
      { #2 }
  }
% text or \\ after the heading: close the heading, open a P for the rest;
% #1 puts back the space the peek removed
\cs_new_protected:Npn \__cv_heading_after:n #1
  {
    \bool_lazy_any:nT
      {
        { \token_if_eq_meaning_p:NN \l_peek_token \\ }
        { \token_if_letter_p:N \l_peek_token }
        { \token_if_other_p:N \l_peek_token }
      }
      { \tagmcend \tagstructend \tagstructbegin { tag = P } \tagmcbegin { } }
    #1
  }
\cs_new_protected:Npn \__cv_heading_after: { \__cv_heading_after:n { } }
\cs_new_protected:Npn \__cv_heading_after_space: { \__cv_heading_after:n { ~ } }
% \extlink's arrow is decoration (the link text says where it goes); without
% this, screen readers read the icon's glyph name, "External-Link-Alt"
\legacy_if:nT { cv@tagged }
  {
    \renewcommand \extarrow
      {
        \textsuperscript
          {
            \tag_mc_end_push: \tag_mc_begin:n { artifact }
            \scalebox { 0.6 } { \faExternalLink* }
            \tag_mc_end: \tag_mc_begin_pop:n { }
          }
      }
  }
\ExplSyntaxOff
% \cvitem's label is empty. With \DocumentMetadata, TeX Live 2026's list code
% reads \item[] as no label and would print the default bullet, so that is
% emptied too (before \begin{itemize}, which reads it).
\newcommand\cv@nobullets{\def\labelitemi{}\def\labelitemii{}}

%% The Faculty of Health grid and spacing, from its vitae format
%% (faculty_of_health_vitae_format.doc, linked from
%% uwaterloo.ca/health/faculty-staff/curriculum-vitae).
% Indents, from the left margin: a part's letter at 0.25in, its title and
% every list's content at 0.5in (the content column). A list inside a part
% starts at the part's title, so it isn't indented again.
\newlength\cvletterindent  \setlength\cvletterindent{0.25in}
\newlength\cvcontentindent \setlength\cvcontentindent{0.5in}
% the label column of a degree group (\printsupervision, cvgroup): labels
% sit left-aligned in the content column and the list starts after the
% widest (MMath, unless the CV sets \cvdegreelabelwidth after
% \begin{document})
\newlength\cvdegreelabelwidth
\AtBeginDocument{\settowidth\cvdegreelabelwidth{MMath}}
\newlength\cvdegreelabelsep \setlength\cvdegreelabelsep{1em}
% \cv@cm: the left margin that puts a list's text in the content column
\newlength\cv@cm
\newcommand\cv@setcm{%
  \setlength\cv@cm{\dimexpr\cvcontentindent-\@totalleftmargin\relax}%
  \ifdim\cv@cm<\z@ \setlength\cv@cm{\z@}\fi}
% Vertical spacing: one blank line after a section heading and between
% blocks at the same level (parts, labelled lists, degree groups); a part's
% title or a \cvsubheading label is followed directly by its content. Lists
% add no space of their own (topsep 0); each block starts with \cv@block,
% which adds the blank line unless it comes straight after a label.
\newif\ifcv@afterlabel
\newcommand\cv@block{%
  \par
  \ifcv@afterlabel\else\addvspace{\baselineskip}\fi
  \global\cv@afterlabelfalse}
\def\cv@notopsep{\topsep\z@\partopsep\z@}
\g@addto@macro\@listI{\cv@notopsep}\let\@listi\@listI
\g@addto@macro\@listii{\cv@notopsep}
\g@addto@macro\@listiii{\cv@notopsep}
\g@addto@macro\@listiv{\cv@notopsep}
\g@addto@macro\@listv{\cv@notopsep}
\g@addto@macro\@listvi{\cv@notopsep}
% a \\ straight after a part's title would leave an empty line before its
% content; the title already ends its line, so it is dropped
\newcommand\cv@dropnewline{\@ifnextchar\\{\cv@dropnewline@}{}}
\def\cv@dropnewline@\\{\@ifstar{\@ifnextchar[\cv@dropopt{}}{\@ifnextchar[\cv@dropopt{}}}
\def\cv@dropopt[#1]{}

% itemsep is added to the list's 5pt parsep, at any depth (so the default,
% -5pt, sets the items on consecutive lines)
\newenvironment{cvlist}[1][-5pt]
  {\cv@block\cv@setcm\cv@nobullets
   \begin{itemize}[leftmargin=\cv@cm, parsep=5pt]\setlength{\labelsep}{0em}\setlength{\itemsep}{#1}}
  {\end{itemize}}
\newcommand\cvitem{\item[]}
% text starts where cvlist's does; the bullet sits in the margin before it.
% Ragged right, so long titles in a narrower (nested) list wrap cleanly.
\newenvironment{cvbulletlist}[1][0pt]
  {\cv@block\cv@setcm
   \begin{itemize}[label=\textbullet, leftmargin=\cv@cm, labelsep=0.5em, itemsep=#1]%
   \raggedright\let\cvitem\item}
  {\end{itemize}}
% a degree group: the label left-aligned in the content column, the list
% after the label column
\newcommand\cv@degreelist{%
  \cv@block\cv@setcm
  \begin{enumerate}[leftmargin=\dimexpr\cv@cm+\cvdegreelabelwidth+\cvdegreelabelsep\relax,
    labelwidth=\cvdegreelabelwidth, labelsep=\cvdegreelabelsep, align=left]}
\newenvironment{cvgroup}[1]
  {\cv@degreelist\item[#1]\leavevmode\global\cv@afterlabeltrue}
  {\end{enumerate}}
\newenvironment{cvparts}
  {\cv@block
   \begin{enumerate}[label=\alph*), leftmargin=\cvcontentindent,
     labelwidth=\dimexpr\cvcontentindent-\cvletterindent\relax, labelsep=0pt,
     align=left, itemsep=\baselineskip, parsep=0pt]}
  {\end{enumerate}\global\cv@afterlabelfalse}
% \cvpart{Title}: a part with a bold title (Publications, Graduate Student
% Supervision); \cvpart*{Title}: a plain one (Presentations, Service), as the
% Faculty's format sets them
\NewDocumentCommand\cvpart{sm}{%
  \item \IfBooleanTF{#1}{#2}{\textbf{#2}}%
  \global\cv@afterlabeltrue
  \cv@dropnewline}
% The prefix is printed as part of the label, not set with biblatex's
% labelprefix: each labelprefix is a separate refcontext, and biber writes a
% full copy of every entry into the .bbl for each one, which can exhaust
% TeX's memory. locallabelwidth (biblatex option above) sizes the label
% column for each heading, prefix included.
\def\cv@labelprefix{}
\DeclareFieldFormat{labelnumberwidth}{\mkbibbrackets{\cv@labelprefix#1}}
\NewDocumentCommand\printcategory{om}{%
  \begingroup
  \IfNoValueTF{#1}{}{\def\cv@labelprefix{#1}}%
  \cv@block
  \printbibliography[category={#2},resetnumbers=true,heading=none]%
  \endgroup}

% cv-layout.tex ends with \makeatother, so it goes last.
\input{cv-layout}

\endinput
