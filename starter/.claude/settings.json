{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "chizen": {
      "source": {
        "source": "github",
        "repo": "JimWallace/CHI-Zen"
      }
    }
  },
  "enabledPlugins": {
    "chizen@chizen": true
  },
  "permissions": {
    "allow": [
      "Bash(python3 scripts/check_cv.py:*)",
      "Bash(python3 scripts/warning_ratchet.py:*)",
      "Bash(python3 scripts/fetch_candidates.py:*)",
      "Bash(latexmk:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)"
    ]
  }
}
